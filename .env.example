# ==================== AMBIENTE ====================
NODE_ENV=development
SERVICE_NAME=operaon_clinical
HOST=0.0.0.0
PORT=4710
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# ==================== BANCO DE DADOS ====================
DATABASE_URL=
DB_NAME=operaon_clinical
DB_USER=dbadmin
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false

# ==================== AUTENTICAÇÃO JWT ====================
# Deve ser compatível com o Identity e com a API gateway.
JWT_ALGORITHM=HS256
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=operaon-identity
JWT_AUDIENCE=operaon-api,operaon-clinical
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ==================== INTEGRAÇÃO BACKEND ====================
# Recebida no header X-Service-Key pela API gateway.
SERVICE_API_KEY=replace-with-a-service-key
CLINICAL_SERVICE_API_KEY=

# ==================== HTTP / CORS ====================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==================== MFA / COMPATIBILIDADE ====================
# O Clinical não emite MFA, mas mantém a variável por compatibilidade operacional.
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-key

# ==================== E-MAIL OPCIONAL ====================
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@operaon.local

# ==================== OPERAON COMMUNICATION CONTRACT ====================
# Identidade não secreta do serviço. Segredos reais devem vir do secret manager.
SERVICE_NAME=operaon-clinical
COMMUNICATION_PROTOCOL_VERSION=1
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
INTERNAL_REQUEST_TIMEOUT_MS=5000
INTERNAL_RETRY_MAX_ATTEMPTS=3
COMMUNICATION_KEY_ID=service-key-v1
WEBHOOK_KEY_ID=webhook-key-v1
